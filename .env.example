DB_USER=pi
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS=true
MQTT_CA_CERT=/opt/s5/certs/server.crt
MQTT_TLS_INSECURE=false
MQTT_TOPIC_ROOT=s3/zigbee
MQTT_BUFFER_DB=mqtt_buffer.db
MQTT_BUFFER_RETENTION_DAYS=7
MQTT_STATUS_INTERVAL_SECONDS=7200
MQTT_LOG_FILE=/home/pi/S3Gateway/log/mqtt.log
GATEWAY_LOG_DIR=/home/pi/S3Gateway/log
GATEWAY_ERROR_LOG_DIR=/home/pi/S3Gateway/log
GATEWAY_ID=s3-gateway-01

# DBKL HTTPS relay/mirror
# Enabled by default. Leave DBKL_HTTPS_URL empty to derive the DBKL host/port
# from encrypted auth_key and preserve the path from rest_location.
DBKL_HTTPS_ENABLED=true
DBKL_HTTPS_URL=
DBKL_HTTPS_TIMEOUT=0.5

# Verify the DBKL server certificate by default. If DBKL omits an intermediate
# certificate from its served chain, set DBKL_CA_CERT to a PEM containing the
# required CA/intermediate chain. Do not disable verification in production.
DBKL_TLS_VERIFY=true
DBKL_CA_CERT=

# DBKL currently accepts a TLS handshake without a client certificate. Keep
# this disabled unless DBKL explicitly requires mTLS in a future deployment.
DBKL_CLIENT_CERT_ENABLED=false
DBKL_CLIENT_CERT=
DBKL_CLIENT_KEY=
